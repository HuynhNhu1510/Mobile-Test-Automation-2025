{
  "login_test_data": {
    "valid_credentials": [
      {
        "testId": "LG.01",
        "category": "Valid Login",
        "email": "khoadang@gmail.com",
        "password": "Kikiga18123@",
        "expectedResult": "success",
        "description": "Valid email and password"
      }
    ],

    "equivalence_partitioning": {
      "invalid_email_format": [
        {
          "testId": "LG.02",
          "category": "Invalid Email - Missing @",
          "email": "invalidemail",
          "password": "ValidPass123@",
          "expectedResult": "email_invalid",
          "expectedMessage": "Please enter valid email address"
        },
        {
          "testId": "LG.03",
          "category": "Invalid Email - Missing domain",
          "email": "test@",
          "password": "ValidPass123@",
          "expectedResult": "email_invalid",
          "expectedMessage": "Please enter valid email address"
        }
      ],

      "invalid_password_format": [
        {
          "testId": "LG.05",
          "category": "Missing Uppercase",
          "email": "testuser@gmail.com",
          "password": "password123@",
          "expectedResult": "credential_error",
          "expectedMessage": "We've had a problem, please try again"
        },
        {
          "testId": "LG.08",
          "category": "Missing Special Character",
          "email": "testuser@gmail.com",
          "password": "Password123",
          "expectedResult": "credential_error",
          "expectedMessage": "We've had a problem, please try again"
        }
      ],

      "invalid_special_characters": [
        {
          "testId": "LG.09",
          "category": "Invalid Special Char - Question Mark",
          "email": "testuser@gmail.com",
          "password": "Pass123?word",
          "expectedResult": "credential_error",
          "expectedMessage": "We've had a problem, please try again"
        }
      ],

      "empty_fields": [
        {
          "testId": "LG.12",
          "category": "Both Fields Empty",
          "email": "",
          "password": "",
          "expectedResult": "empty_field_error",
          "expectedMessage": "Please enter your email address"
        },
        {
          "testId": "LG.14",
          "category": "Password Empty",
          "email": "validuser@gmail.com",
          "password": "",
          "expectedResult": "password_empty",
          "expectedMessage": "Please enter your password"
        }
      ]
    },

    "boundary_value_analysis": {
      "password_length": [
        {
          "testId": "LG.15",
          "category": "BVA - Min Length (8 chars)",
          "email": "testuser@gmail.com",
          "password": "Pass123@",
          "expectedResult": "credential_error",
          "description": "Minimum valid password length"
        },
        {
          "testId": "LG.16",
          "category": "BVA - Below Min (7 chars)",
          "email": "testuser@gmail.com",
          "password": "Pas12@",
          "expectedResult": "credential_error",
          "description": "Below minimum boundary"
        },
        {
          "testId": "LG.17",
          "category": "BVA - Long Password (50 chars)",
          "email": "testuser@gmail.com",
          "password": "Pass123@Pass123@Pass123@Pass123@Pass123@Pass123@AB",
          "expectedResult": "credential_error",
          "description": "Long password test"
        }
      ],

      "email_length": [
        {
          "testId": "LG.18",
          "category": "BVA - Shortest Valid Email",
          "email": "a@b.c",
          "password": "ValidPass123@",
          "expectedResult": "credential_error",
          "description": "Minimum valid email format"
        },
        {
          "testId": "LG.20",
          "category": "BVA - Exceed Local Part (65 chars)",
          "email": "abcdefghijklmnopqrstuvwxyz1234567890abcdefghijklmnopqrstuvwxyz123@test.com",
          "password": "ValidPass123@",
          "expectedResult": "email_invalid",
          "description": "Exceeds maximum local part"
        }
      ]
    }
  },

